# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Raw input (large; licensing/PII — never commit)
/data/

# Generated outputs (large, regenerable). Manifests/JSON summaries are kept.
/parsed/
/normalized/*.parquet
/normalized/mappings/
/paths/*.parquet
/transition_network/*.parquet
/career_clean/results/*.parquet
/cohorts/*.parquet

# Cleaning cache (regenerable)
/edu_clean/cache/
/career_clean/cache/
/industry/cache/

# Industry classifier outputs (regenerable parquet; JSON summaries kept)
/industry/results/*.parquet

# Portal substrate cache (regenerable membership/panel parquet + key)
/portal/results/_cache/
# Portal run logs (debug debris; JSON summaries are kept)
/portal/results/*.log

# --- F1 hardening (2026-09-01 recovery/refactor) ---
# Windows sidecar junk
*Zone.Identifier
# Backup debris
*.bak
# Industry LLM proposal cache (would be >2GB if re-fired; never committable)
/industry/llm_proposals.jsonl
# Archetypes generated outputs (parquet; JSON summaries elsewhere are kept)
/archetypes/results/
# Enrichment generated outputs
/enrichment/results/*.parquet
# Cohorts/paths large generated parquet already covered above
# Obsidian vault symlink (personal notes, outside the repo)
/vault
# Local caches
.ruff_cache/
__pycache__/
# Vote caches too large for GitHub (kept on disk + backed up out of band)
/career_clean/results/soc_votes.jsonl
# Run logs in results dirs
/career_clean/results/*.log
/industry/results/*.log
# Generated portal/share build outputs (regenerable via portal/run_share_build.py)
/portal/results/portal_data.json
/share/*.html
/share/*.zip
/edu_clean/results/*.log
