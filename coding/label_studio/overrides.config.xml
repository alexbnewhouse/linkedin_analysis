<View>
  <Header value="Is the override occupation code right for this title at this employer?"/>
  <Text name="rubric" value="$rubric"/>
  <View style="display: grid; grid-template-columns: 1fr; gap: 4px; padding: 8px; background: #f7f7f7; border-radius: 6px">
    <Header value="title_raw" size="6"/>
    <Text name="title_raw" value="$title_raw"/>
    <Header value="company_raw" size="6"/>
    <Text name="company_raw" value="$company_raw"/>
    <Header value="industry_l1" size="6"/>
    <Text name="industry_l1" value="$industry_l1"/>
    <Header value="industry_l2" size="6"/>
    <Text name="industry_l2" value="$industry_l2"/>
    <Header value="reason" size="6"/>
    <Text name="reason" value="$reason"/>
    <Header value="occupation_code_before" size="6"/>
    <Text name="occupation_code_before" value="$occupation_code_before"/>
    <Header value="occupation_code_override" size="6"/>
    <Text name="occupation_code_override" value="$occupation_code_override"/>
    <Header value="occupation_label" size="6"/>
    <Text name="occupation_label" value="$occupation_label"/>
  </View>
  <Choices name="label" toName="rubric" choice="single" required="true" showInline="true">
      <Choice value="pass"/>
      <Choice value="fail"/>
      <Choice value="unsure"/>
  </Choices>
  <TextArea name="note" toName="rubric" placeholder="why (optional)" maxSubmissions="1" rows="2"/>
</View>
