<View>
  <Header value="Is the assigned SOC major group right for this job title at this employer?"/>
  <Text name="rubric" value="$rubric"/>
  <View style="display: grid; grid-template-columns: 1fr; gap: 4px; padding: 8px; background: #f7f7f7; border-radius: 6px">
    <Header value="title_raw" size="6"/>
    <Text name="title_raw" value="$title_raw"/>
    <Header value="company_raw" size="6"/>
    <Text name="company_raw" value="$company_raw"/>
    <Header value="industry_l1" size="6"/>
    <Text name="industry_l1" value="$industry_l1"/>
    <Header value="title_family" size="6"/>
    <Text name="title_family" value="$title_family"/>
    <Header value="title_seniority9" size="6"/>
    <Text name="title_seniority9" value="$title_seniority9"/>
    <Header value="soc_major" size="6"/>
    <Text name="soc_major" value="$soc_major"/>
    <Header value="soc_major_label" size="6"/>
    <Text name="soc_major_label" value="$soc_major_label"/>
  </View>
  <Choices name="label" toName="rubric" choice="single" required="true" showInline="true">
      <Choice value="pass"/>
      <Choice value="fail"/>
      <Choice value="unsure"/>
  </Choices>
  <TextArea name="note" toName="rubric" placeholder="why (optional)" maxSubmissions="1" rows="2"/>
</View>
