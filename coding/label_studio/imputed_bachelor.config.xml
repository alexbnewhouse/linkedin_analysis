<View>
  <Header value="Is this row plausibly a bachelor's degree (completed or in progress) at a bachelor's-granting institution?"/>
  <Text name="rubric" value="$rubric"/>
  <View style="display: grid; grid-template-columns: 1fr; gap: 4px; padding: 8px; background: #f7f7f7; border-radius: 6px">
    <Header value="school_raw" size="6"/>
    <Text name="school_raw" value="$school_raw"/>
    <Header value="degree_raw" size="6"/>
    <Text name="degree_raw" value="$degree_raw"/>
    <Header value="field_raw" size="6"/>
    <Text name="field_raw" value="$field_raw"/>
    <Header value="description" size="6"/>
    <Text name="description" value="$description"/>
    <Header value="start_year" size="6"/>
    <Text name="start_year" value="$start_year"/>
    <Header value="end_year" size="6"/>
    <Text name="end_year" value="$end_year"/>
    <Header value="cip2_pooled" size="6"/>
    <Text name="cip2_pooled" value="$cip2_pooled"/>
    <Header value="field_group" size="6"/>
    <Text name="field_group" value="$field_group"/>
  </View>
  <Choices name="label" toName="rubric" choice="single" required="true" showInline="true">
      <Choice value="pass"/>
      <Choice value="fail"/>
      <Choice value="unsure"/>
  </Choices>
  <TextArea name="note" toName="rubric" placeholder="why (optional)" maxSubmissions="1" rows="2"/>
</View>
